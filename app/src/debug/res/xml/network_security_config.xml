<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      DEBUG BUILDS ONLY. Overrides the release config to trust one self-signed
      certificate, so the app can be exercised against a local HTTPS server.

      Two things this enables that the release build deliberately cannot:
        - a real HTTPS origin, which a cross-site cookie requires, since
          SameSite=None is only honoured on a Secure connection;
        - cleartext, so an HTTP server still works for quick checks.

      A self-signed CA must never ship in a release build, which is exactly why
      this lives in src/debug and shadows the release file of the same name.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/debug_ca" />
        </trust-anchors>
    </debug-overrides>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!--
              `system` first, and this is not optional. Listing trust anchors
              REPLACES the set rather than adding to it, so omitting it means the
              only certificate this build trusts is the local one, and then every
              real HTTPS site fails with an SSL handshake error. That looks
              exactly like "the app broke the internet".
            -->
            <certificates src="system" />
            <certificates src="@raw/debug_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
