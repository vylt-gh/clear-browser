<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      The same silhouette. Themed icons take only the alpha channel and tint it,
      and the artwork is a solid shape, so it is already correct as a monochrome
      source and re-drawing it would only risk the two drifting apart.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
