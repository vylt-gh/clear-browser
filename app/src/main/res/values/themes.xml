<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      A bare no-action-bar theme. All real theming is done in Compose from the M3
      color scheme; this only needs to get out of the way and not fight
      edge-to-edge.

      The parent must track the system scheme. WebView derives
      `prefers-color-scheme` from this theme's `isLightTheme`, so a fixed parent
      would tell every site "light" while Compose renders a dark UI: sites would
      serve light pages into a dark browser and the two would disagree.
      values-night/themes.xml supplies the dark counterpart.
    -->
    <!--
      The contrast-enforcement flags are API 29+. Below that they are simply
      absent, which is the desired behaviour: the platform did not draw a scrim
      in the first place, and the bars are transparent regardless.
    -->
    <style name="Theme.ClearBrowser" parent="android:Theme.Material.Light.NoActionBar" tools:targetApi="29">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
